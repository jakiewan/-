---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	agent_decide(agent_decide)
	execute_tools(execute_tools)
	mark_tool_limit(mark_tool_limit)
	collect_agent_result(collect_agent_result)
	__end__([<p>__end__</p>]):::last
	__start__ --> agent_decide;
	agent_decide -.-> collect_agent_result;
	agent_decide -.-> execute_tools;
	agent_decide -.-> mark_tool_limit;
	execute_tools --> agent_decide;
	mark_tool_limit --> collect_agent_result;
	collect_agent_result --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
